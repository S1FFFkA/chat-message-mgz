# =============================================================================
# chat-message-mgz — пример переменных окружения
# Скопируйте в .env и подставьте свои значения: copy .env.example .env
# =============================================================================

# --- gRPC-сервер (go run ./cmd/main.go, Docker app) --------------------------
# Обязательно: строка подключения к PostgreSQL.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/chat_message?sslmode=disable

# Порт gRPC (по умолчанию 50051).
GRPC_PORT=50051

# Redis: если пусто — кэш отключён, сервис работает только с БД.
REDIS_ADDR=127.0.0.1:6379

# Пароль Redis (если не используется — оставьте пустым).
REDIS_PASSWORD=

# Номер логической БД Redis (целое число, по умолчанию 0).
REDIS_DB=0

# TTL кэша списков/превью (формат Go duration: 20m, 1h30m).
CACHE_TTL=20m

# --- Kafka (уведомления о новых непрочитанных сообщениях) --------------------
# CSV список брокеров: 127.0.0.1:9092 (с хоста) или kafka:9092 (из контейнеров в общей Docker-сети).
KAFKA_BROKERS=127.0.0.1:9092

# Имя топика по умолчанию совпадает с push-consumer в user-mgz (то же значение у KAFKA_TOPIC_CHAT_MESSAGES там).
KAFKA_TOPIC_CHAT_MESSAGES=chat.messages

# --- CLI-клиент (go run ./cmd/client ...) ------------------------------------
# Адрес gRPC без схемы. По умолчанию в коде: 127.0.0.1:50051 (см. cmd/client).
CHAT_GRPC_ADDR=127.0.0.1:50051

# --- Локальный docker-compose (сервис postgres) ------------------------------
# Используются образом postgres, если задаёте их через env_file или environment.
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=chat_message
